# Local Development Environment Configuration
# Copy this file to local.env and fill in your actual values
# local.env is gitignored and should never be committed

# Runtime Environment
RUNTIME_ENV=dev

GITHUB_TOKEN=ghp_your_personal_access_token_here

# AWS Configuration
# Required for AWS services integration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_CLIENT_SECRET_NAME=your-client-secret-name
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
EVENT_BUS_NAME=your_event_bus_name_here

# AWS Cognito User Pools
# Main application user pool
AWS_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_APP_CLIENT_ID=your_app_client_id
AWS_APP_CLIENT_SECRET=your_app_client_secret

# Admin console user pool
AWS_ADMIN_CONSOLE_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_ADMIN_CONSOLE_APP_CLIENT_ID=your_admin_console_client_id

# Management app user pool
AWS_MANAGE_APP_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_MANAGE_APP_APP_CLIENT_ID=your_manage_app_client_id

# AI/ML API Keys
# OpenAI API key for GPT models
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API key for fast inference
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Router Configuration
MODEL_ROUTER_BASE_URL=https://your-api-gateway.execute-api.us-east-1.amazonaws.com/lat/
MODEL_ROUTER_API_KEY=your_model_router_api_key

# Mem0 API key for memory management
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cohere API key
COHERE_API_KEY=your_cohere_api_key

# Pinecone API key for vector database
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_GPT4O=your-deployment-name

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key

# TrueFoundry AI Gateway Configuration (Temporarily deprecated, please use Azure credentials)
TRUEFOUNDRY_API_KEY=your_truefoundry_api_key
TRUEFOUNDRY_BASE_URL="https://gateway.truefoundry.ai"
TRUEFOUNDRY_MODEL_ID=your_model_id

# Twilio Configuration (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_or_n/a
TWILIO_AUTH_TOKEN=your_twilio_auth_token_or_n/a
MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=pal-mono
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Shared Redis Cache (AWS ElastiCache / Redis / Valkey)
# Disabled by default for local development. Deployed environments should use
# TLS plus either a Secrets Manager auth token or IAM auth.
REDIS_CACHE_ENABLED=false
REDIS_CACHE_HOST=
REDIS_CACHE_PORT=6379
REDIS_CACHE_USERNAME=
REDIS_CACHE_AUTH_MODE=secrets_manager
REDIS_CACHE_SECRET_KEY=REDIS_CACHE_AUTH_TOKEN
REDIS_CACHE_SSL=true
REDIS_CACHE_DEFAULT_TTL_SECONDS=1800
REDIS_CACHE_MAX_ITEM_BYTES=32768
REDIS_CACHE_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_CACHE_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_CACHE_HEALTH_CHECK_INTERVAL_SECONDS=30
# Local fallback only when REDIS_CACHE_AUTH_MODE=secrets_manager.
# In deployed environments, store this value in AWS Secrets Manager.
REDIS_CACHE_AUTH_TOKEN=your_redis_auth_token

# Langfuse LLM Observability
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Disable ddtrace auto-instrumentation (transitive dep via pal-agents)
# Prevents ddtrace from intercepting OTel traces. Remove once pal-agents drops ddtrace.
DD_TRACE_ENABLED=false
DD_INSTRUMENTATION_TELEMETRY_ENABLED=false

# Stripe Configuration
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

#AgenticMem
AGENTICMEM_URL=x
AGENTICMEM_EMAIL=x
AGENTICMEM_PASSWORD=x
